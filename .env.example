# --- Required ---
DISCORD_TOKEN=            # Bot token from Discord Developer Portal > Bot
# --- Strongly recommended (without it X metrics are skipped and results are provisional) ---
X_BEARER_TOKEN=           # X API v2 app bearer token (Basic tier or higher for search/recent + counts)
# --- Optional ---
DISCORD_GUILD_ID=         # sync commands to one guild instantly (else global, up to ~1h)
SYNC_COMMANDS=true        # set true on first run / after changing commands
DATABASE_URL=sqlite:///hypebot.db   # or postgresql://user:pass@host:5432/hypebot
COINGECKO_API_KEY=        # optional CoinGecko demo key (public endpoint works without, rate-limited)
WEIGHTS_FILE=weights.json
# WEIGHT_ENGAGEMENT_QUALITY=25   # per-component env overrides
PROVISIONAL_CONFIDENCE=0.6
INFLUENCER_MIN_FOLLOWERS=10000
TIERS=80,60,40          # lower bounds for T1..T3; below last = T4
LOG_LEVEL=INFO
# --- Research / manual review ---
REVIEWER_USER_IDS=922754935806894091   # comma-separated Discord user IDs allowed to /review
REVIEWER_ROLE_IDS=                     # comma-separated role IDs allowed to /review
# --- Sorsa (optional crypto social-graph verification; docs/SORSA.md) ---
SORSA_API_KEY=                 # from https://sorsa.io — free plan ≈ 100 requests total. Absent = Sorsa marked unavailable (no penalty)
SORSA_AUTO_FETCH=true          # research jobs fetch the 3-call pack (score, followers-stats, top-followers) when a key is set
SORSA_CACHE_TTL_H=24           # cache per (endpoint, handle)
SORSA_MIN_REMAINING=10         # soft-stop: no live calls below this many remaining requests (scripts: --force)
SORSA_OPTIONAL_MIN_REMAINING=40  # score-changes / new-followers-7d only when remaining > this (or cached)
SEED_ACCOUNTS_FILE=seed_accounts.json
